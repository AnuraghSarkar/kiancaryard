# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/used-cars
# Or use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/used-cars

# Server Port
PORT=5000

# JWT Secret (for authentication - future feature)
JWT_SECRET=your_secret_key_here

# Optional: Image Upload Service
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
